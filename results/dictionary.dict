# Minimal PDF dictionary for AFL++ (use with: afl-fuzz -x dict/pdf.dict ...)
# Tokens that steer the mutator toward valid PDF structure. Extend it yourself
# in Task 2 — a better dictionary is part of the coverage work.
obj="obj"
endobj="endobj"
stream="stream"
endstream="endstream"
xref="xref"
trailer="trailer"
startxref="startxref"
eof="%%EOF"
type="/Type"
catalog="/Catalog"
pages="/Pages"
page="/Page"
kids="/Kids"
count="/Count"
contents="/Contents"
resources="/Resources"
mediabox="/MediaBox"
font="/Font"
subtype="/Subtype"
type1="/Type1"
basefont="/BaseFont"
length="/Length"
filter="/Filter"
flatedecode="/FlateDecode"
ascii85="/ASCII85Decode"
asciihex="/ASCIIHexDecode"
lzw="/LZWDecode"
runlength="/RunLengthDecode"
dct="/DCTDecode"
ccitt="/CCITTFaxDecode"
jbig2="/JBIG2Decode"
jpx="/JPXDecode"
root="/Root"
size="/Size"
prev="/Prev"
encrypt="/Encrypt"
info="/Info"
linearized="/Linearized"
objstm="/ObjStm"
xrefstm="/XRefStm"
w="/W"
index="/Index"
dict_open="<<"
dict_close=">>"
arr_open="["
arr_close="]"

